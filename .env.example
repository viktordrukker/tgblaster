# --- Telegram API (https://my.telegram.org → API development tools) ---
TG_API_ID=
TG_API_HASH=
# Session file: sessions/<TG_SESSION_NAME>.session (created by `blaster login`)
TG_SESSION_NAME=tg_session

# Default country for numbers written without a code (90 123 45 67 → +998…)
DEFAULT_REGION=UZ

# --- Pacing (conservative defaults; a warmed-up account can go faster) ---
# Max messages per rolling 24h across ALL campaigns.
DAILY_CAP=150
# Random delay between messages, seconds.
MIN_DELAY_SEC=40
MAX_DELAY_SEC=100
# Every N messages a long pause, seconds.
LONG_PAUSE_EVERY=30
LONG_PAUSE_MIN_SEC=600
LONG_PAUSE_MAX_SEC=900
# Send only inside this local-time window (recipients' time zone).
SEND_WINDOW=09:00-21:00
TZ_SEND=Asia/Tashkent
# FloodWait longer than this → stop (resume later) instead of sleeping.
MAX_FLOOD_WAIT_SEC=1800
# Stop after this many PeerFlood errors (Telegram's anti-spam limit).
PEER_FLOOD_STOP=2

# --- Web UI ---
# Password for http://127.0.0.1:8501 (empty = none). Also editable on the Settings page.
UI_PASSWORD=
